# Copy this file to .env (in the same folder as package.json), fill it in, and restart eBilling.
# .env stays on this computer or server only: it's never uploaded to GitHub.

# The email account eBilling sends backups FROM. Where they go TO is set in Settings → Backup & restore.
#
# Gmail:
#   1. Turn on 2-Step Verification in your Google Account (Security).
#   2. Google Account → Security → App passwords: make one named "eBilling".
#   3. Paste its 16 letters as SMTP_PASS (not your normal Gmail password).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=yourname@gmail.com
SMTP_PASS=
MAIL_FROM="Devesh Studio eBilling <yourname@gmail.com>"

# A Hostinger mailbox instead: SMTP_HOST=smtp.hostinger.com, SMTP_USER=ebill@deveshstudio.com, SMTP_PASS=its password.

# Daily backups go out from 9 pm by this clock. Set it when the server isn't on India time (most online servers aren't).
# TZ=Asia/Kolkata
